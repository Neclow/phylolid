; MEGA-CC options: neighbour-joining tree from a distance matrix (MEGA .meg, DataType=Distance), no test of phylogeny.
; Written by hand from MEGA-generated files: the distance settings of values2tree's infer_UPGMA_distances.mao
; (github.com/pegi3s/dockerfiles) and the neighbour-joining settings of a MEGA 12 infer_NJ_nucleotide.mao
; (github.com/rogotoh/PMiFish). Checked with megacc 12.1.3 on a 4-taxon additive matrix.
[ MEGAinfo ]
ver                           = 12261001-x86_64 Linux
[ DataSettings ]
datatype                      = snDistance
MissingBaseSymbol             = ?
IdenticalBaseSymbol           = .
GapSymbol                     = -
[ ProcessTypes ]
ppInfer                       = true
ppNJ                          = true
[ AnalysisSettings ]
Analysis                      = NJ Phylogeny Reconstruction
Scope                         = All Selected Taxa
Statistical Method            = Neighbor-joining
System Resource Usage         = ====================
Number of Threads             = 1
Has Time Limit                = False
Maximum Execution Time        = -1
